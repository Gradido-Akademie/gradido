COMMUNITY_HOST=$COMMUNITY_HOST
URL_PROTOCOL=$URL_PROTOCOL
WALLET_AUTH_PATH=$WALLET_AUTH_PATH
WALLET_LOGIN_PATH=$WALLET_LOGIN_PATH
GRAPHQL_PATH=$GRAPHQL_PATH
DEBUG_DISABLE_AUTH=false

HUMHUB_ACTIVE=$HUMHUB_ACTIVE
HUMHUB_API_URL=$HUMHUB_API_URL
# STAGING ONLY - do not port to the main repo.
# A literal instead of the $ANTHROPIC_ACTIVE placeholder, so the Crea chat window is
# visible on ki-playground even if the server's own deployment/bare_metal/.env does not
# define the variable at all (envsubst would leave it empty and switch the window off).
# It is a fallback, not an override: start.sh exports the server's .env into process.env
# before the build, and dotenv does not overwrite what is already there - so a server
# that deliberately sets false still wins.
ANTHROPIC_ACTIVE=true
